# =====================================================================
# FitCore Environment Configuration Template
# Copy this file to .env and customize the values for your local setup.
# DO NOT commit the active .env file to version control.
# =====================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
API_ENV=development
DEBUG=True

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
API_V1_PREFIX=/api/v1

# Security & Secrets (generate strong random secrets for production)
SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars
JWT_SECRET=change-this-to-a-secure-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL)
# Async connection string for FastAPI application:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fitcore_dev
# Sync connection string for Alembic migrations:
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/fitcore_dev

# CORS & Frontend Origins
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
